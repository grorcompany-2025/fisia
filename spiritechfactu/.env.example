# ============================================================================
# .env.example - Variables de entorno para SpiritechFactu
# ============================================================================
# Copiar este archivo a .env y rellenar los valores reales
# NO COMPROMETER .env EN GIT

# ============================================================================
# GENERAL
# ============================================================================
NODE_ENV=development
PORT=3000
HOST=localhost
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# FIREBASE / FIRESTORE
# ============================================================================
# TODO: Crear cuenta en Firebase y obtener credenciales
# https://console.firebase.google.com/
FIREBASE_PROJECT_ID=spiritechfactu
FIREBASE_PRIVATE_KEY=your-private-key-here
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com

# ============================================================================
# SEGURIDAD
# ============================================================================
# Generar con: openssl rand -base64 32
API_SECRET=your-secret-key-here

# ============================================================================
# AEAT / VERIFACTU
# ============================================================================
# Endpoint SOAP de AEAT
AEAT_SOAP_URL=https://www.agenciatributaria.gob.es/webservices/VeriFactu/VeriFactuWebService.asmx

# TODO: Certificado digital para firma
# Descargable desde el portafirmas de AEAT
AEAT_CERTIFICATE_PATH=/path/to/certificate.pfx
AEAT_CERTIFICATE_PASSWORD=your-certificate-password

# ============================================================================
# VERIFACTU
# ============================================================================
# testing o production
VERIFACTU_MODE=testing

# SHA256 o SHA512
HASH_ALGORITHM=SHA256

# ID del software (asignado por AEAT en homologación)
SOFTWARE_ID=SpiritechFactu_v1
SOFTWARE_VERSION=1.0.0

# ============================================================================
# PDF
# ============================================================================
PDF_MARGIN=40
PDF_FONT_SIZE=12

# ============================================================================
# LOGS
# ============================================================================
LOG_LEVEL=info
LOG_FILE=/var/log/spiritechfactu/backend.log

# ============================================================================
# BASE DE DATOS (para futuras integraciones)
# ============================================================================
# DATABASE_URL=mongodb://localhost:27017/spiritechfactu
# DATABASE_USER=
# DATABASE_PASSWORD=
